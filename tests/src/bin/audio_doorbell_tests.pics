# PICS values for the `audio_doorbell_tests` executable
#
# Covers the Matter 1.5 audio doorbell clusters implemented in audio_doorbell_tests.rs:
#   - CameraAvStreamManagement (AVSM) – audio-only (Feature::AUDIO | Feature::SPEAKER)
#   - Chime (CHIME)

# -----------------------------------------------------------------------
# Chime cluster (0x0556)
# -----------------------------------------------------------------------
CHIME.S=1
CHIME.S.A0000=1
CHIME.S.A0001=1
CHIME.S.A0002=1
CHIME.S.C00.Rsp=1

# -----------------------------------------------------------------------
# CameraAvStreamManagement (0x0560 / 0x0551)
# audio + speaker features (F01, F02)
# -----------------------------------------------------------------------
AVSM.S=1
AVSM.S.F00=0
AVSM.S.F01=1
AVSM.S.F02=1
AVSM.S.F03=0
