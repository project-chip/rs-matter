BINFO.S.A0016=1
# A0017 (DeviceLocation) is implemented (admin-writable, persisted in
# `BasicInfoSettings`) but provisional in Matter 1.6, so it is excluded from
# the default `BasicInfoHandler` metadata (upstream's `TestBasicInformation`
# pins `AttributeList` to an exact set without it). The `--app-pipe`-selected
# alternate node advertises it via `basic_info::CLUSTER_DEVICE_LOCATION`, which
# is how `TC_BINFO_2_1` exercises its steps 24-28; that test gates those steps
# on the live `AttributeList` (`attribute_guard`), not on this PICS entry.
BINFO.S.A0017=0
# A0018 (ConfigurationVersion) IS exposed by default: although provisional, its
# conformance is `P, Rev >= v5`, i.e. mandatory from cluster revision 5 onwards,
# and `BasicInformation` is revision 6 in Matter 1.6. `TestBasicInformation`
# constrains `AttributeList` to an exact set that includes it.
BINFO.S.A0018=1

# Manufacturer-specific: whether the device can be made to change its
# configuration and bump `ConfigurationVersion` on demand.
#
# Left disabled. The original rationale ("the default device doesn't expose
# `ConfigurationVersion`") no longer holds - it is exposed by default as of
# Matter 1.6 - and it never gated `TC_BINFO_3_2` anyway, since that test is run
# against CHIP's own `certification/ci-pics-values` file rather than this one
# (see `extra_python_script_args` in `xtask/src/itest.rs`). Enabling it is a
# separate question from the 1.6 bump: it would opt this device into the
# simulated-bump assertions of any test that reads this PICS file, which has
# not been exercised.
BINFO.S.M.DeviceConfigurationChange=0

