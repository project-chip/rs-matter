CC.S.A400a=1
CC.S.A400b=1
CC.S.A400c=1
CC.S.A400d=1
CC.S.A4010=1

# Commands — server response side.
CC.S.C00.Rsp=1
CC.S.C01.Rsp=1
CC.S.C02.Rsp=1
CC.S.C03.Rsp=1
CC.S.C04.Rsp=1
CC.S.C05.Rsp=1
CC.S.C06.Rsp=1
CC.S.C07.Rsp=1
